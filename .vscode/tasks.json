{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-android",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/AppAndroidHolaMundo.Presentation/AppAndroidHolaMundo.Presentation.csproj",
                "-t:Run",
                "-f",
                "net10.0-android",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
