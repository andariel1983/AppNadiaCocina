<Project>
  <!-- JDK y Android SDK se instalaron en el home del usuario (sin sudo), no en rutas del sistema.
       Esta configuración evita tener que exportar JAVA_HOME/ANDROID_SDK_ROOT en cada build. -->
  <PropertyGroup>
    <AndroidSdkDirectory>/home/rutherford/android-tools/android-sdk</AndroidSdkDirectory>
    <JavaSdkDirectory>/home/rutherford/android-tools/jdk17</JavaSdkDirectory>
  </PropertyGroup>
</Project>
